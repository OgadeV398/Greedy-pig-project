# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Preferred (Render / Railway / Neon / Supabase connection string):
DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/greedy_pig
# Or, locally, the individual settings from the main README:
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=greedy_pig
# DB_PASSWORD=your_postgres_password
# DB_PORT=5432

# --- Auth (REQUIRED in production; use a long random string) ---
# generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGIN=http://localhost:5173,https://greedy-pig.vercel.app

# --- Optional: per-IP requests/minute (default 1200; a whole class may share one IP) ---
# RATE_LIMIT_PER_MIN=1200
